int main()
{
	int i;
	int s = 0;
	for (i = 1; i <= 5; i = i + 1)
		s = s + i;
	cout << s << "\n";

	i = 0;
	while (i < 3)
	{
		cout << i;
		i = i + 1;
	}
	cout << "\n";

	if (s == 15)
		cout << "ok\n";
	else
		cout << "bad\n";

	auto t = concat("ab", "c");
	cout << t << " " << length(t) << " " << find(t, "b") << " " << sort("cba") << "\n";
	cout << substr("hello", 1, 3) << "\n";
	return 0;
}
