int factorial(int n);

int marker()
{
	cout << "call ";
	return;
}

int forever_once()
{
	for (;;)
		return 7;
}

int factorial(int n)
{
	if (n <= 1)
		return 1;
	return n * factorial(n - 1);
}

int main()
{
	;
	{}
	marker();

	int i;
	i = 0;
	for (; i < 3; )
		i = i + 1;

	if (!(i != 3))
	{
		cout << factorial(3) << " " << forever_once() << " ";
	}
	else
		cout << "bad ";

	cout << i % 2 << " " << (i >= 3) << " " << -(1 + 2) << "\n";
	return 0;
}
